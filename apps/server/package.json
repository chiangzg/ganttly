    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "nanoid": "^5.0.7",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@ganttly/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "light-my-request": "^6",
    "tsx": "^4.23.12",
