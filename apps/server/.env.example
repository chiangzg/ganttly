# ganttly server — environment (spec §14.2).
# Copy to .env and adjust. Production must set all required vars; AUTH_MODE=dev
# is rejected in production (spec §8.2).

# --- Core (required in every environment) ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ganttly
GANTTLY_INSTANCE_ID=inst_dev
GANTTLY_INSTANCE_NAME=ganttly Dev
PUBLIC_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:5173

# --- Auth (GitHub OAuth, spec §8.2) ---
# AUTH_MODE=dev injects a fixed test user. In production AUTH_MODE MUST be
# `github` and the secrets below MUST be set, otherwise startup fails fast.
AUTH_MODE=dev
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# SESSION_SECRET=            # >=32 bytes; rotate per deploy
# TOKEN_PEPPER=              # random >=32 bytes for PAT hashing
ALLOWED_WEB_ORIGINS=http://localhost:5173

# --- Document limits (overridable; defaults in @ganttly/api-contract) ---
# MAX_PROJECT_BYTES=10485760
# MAX_PROJECT_TASKS=10000
