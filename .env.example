# ganttly self-hosted — Docker Compose environment (spec §14.2).
#
#   cp .env.example .env    # then fill in every value below
#
# Never commit or share the real .env; it holds your secrets.

# --- Postgres (compose service) ---------------------------------------------
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=change-me
# The compose file derives DATABASE_URL from this password automatically
# (postgres://postgres:<password>@postgres:5432/ganttly) — do not set it here.

# --- Public identity (required) ----------------------------------------------
# Where users reach this instance. Same-origin single-container deploy:
# WEB_APP_URL equals PUBLIC_BASE_URL. Use your LAN IP or domain, e.g.
#   http://192.168.1.10:3001   (plain-HTTP LAN deploy, see cookie note below)
#   https://ganttly.example.com (behind a TLS reverse proxy — recommended)
PUBLIC_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3001
GANTTLY_INSTANCE_ID=inst_mycompany
GANTTLY_INSTANCE_NAME=ganttly (My Company)

# Host port for the server container (optional; container always listens on 3001)
# GANTTLY_PORT=3001

# --- OIDC login (required in production) ---------------------------------------
# ganttly logs in via a standard OIDC provider (e.g. authentik). Full setup:
# docs/self-hosting.md §OIDC.
# 1. Create an OAuth2/OpenID provider in your IdP (confidential client).
# 2. Redirect URI:  <PUBLIC_BASE_URL>/api/v1/auth/oidc/callback
# 3. OIDC_ISSUER_URL is the issuer shown by the IdP, e.g.
#      https://auth.example.com/application/o/ganttly/
AUTH_MODE=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Space-separated scopes; the default covers identity only.
# OIDC_SCOPES=openid profile email

# Who may sign in is governed at the IdP: bind the application to a group or
# access policy there. ganttly itself keeps no login allowlist.

# --- Secrets (required in production) ------------------------------------------
# Generate each independently: openssl rand -hex 32
SESSION_SECRET=
TOKEN_PEPPER=

# --- Session cookie --------------------------------------------------------------
# The image runs NODE_ENV=production, so the session cookie is Secure by
# default — which only works over HTTPS. For a plain-HTTP LAN deployment set
# false (trusted network only!). Behind a TLS proxy, remove this line or set
# true.
SESSION_COOKIE_SECURE=false

# --- Optional tuning (defaults are fine) ---------------------------------------
# LOG_LEVEL=info
# ALLOWED_WEB_ORIGINS=          # empty = same-origin only (recommended). Required when a
#                               # cross-origin web frontend connects ("添加远端服务"), e.g.
#                               # ALLOWED_WEB_ORIGINS=http://localhost:5173,https://jiang.github.io
# MAX_PROJECT_BYTES=10485760
# MAX_PROJECT_TASKS=10000
# RATE_LIMIT_MAX=300
# METRICS_ENABLED=true
